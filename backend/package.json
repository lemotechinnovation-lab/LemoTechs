{
  "name": "backend",
  "version": "1.0.0",
  "description": "LemoTech API Backend - On-demand cleaning services",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "dev:debug": "nodemon --exec \"node --inspect-brk -r ts-node/register\" src/app.ts",
    "debug": "node --inspect-brk ./node_modules/.bin/ts-node src/app.ts",
    "build": "tsc -p tsconfig.prod.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Tests not configured yet\"",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:up": "node scripts/migrate.js migrate",
    "migrate:create": "node scripts/migrate.js create",
    "migrate:down": "node scripts/migrate.js rollback",
    "migrate:prod": "NODE_ENV=production node scripts/migrate.js migrate",
    "deploy:build": "npm run clean && npm run build",
    "deploy:start": "npm run migrate:prod && npm start",
    "migrate:reset": "node scripts/migrate.js reset --confirm",
    "migrate:reset-seed": "node scripts/migrate.js reset --confirm --seed",
    "migrate:seed": "node scripts/migrate.js seed",
    "migrate:validate": "node scripts/migrate.js validate",
    "migrate:schema": "node scripts/migrate.js schema",
    "migrate:backup": "node scripts/migrate.js backup",
    "migrate:restore": "node scripts/migrate.js restore",
    "db:legacy": "node-pg-migrate -m src/infrastructure/migrations",
    "db:legacy:create": "node-pg-migrate create -m src/infrastructure/migrations",
    "db:legacy:up": "node-pg-migrate up -m src/infrastructure/migrations",
    "db:legacy:down": "node-pg-migrate down -m src/infrastructure/migrations",
    "postinstall": "tsc -p tsconfig.prod.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@microsoft/signalr": "^9.0.6",
    "@microsoft/signalr-protocol-msgpack": "^9.0.6",
    "@sendgrid/client": "^8.1.5",
    "@sendgrid/mail": "^8.1.5",
    "@types/winston": "^2.4.4",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "debug": "^4.3.4",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-payfast": "^1.0.2",
    "nodemailer": "^7.0.5",
    "payfast": "^1.0.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^17.7.0",
    "twilio": "^5.9.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "typescript": "^5.9.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  }
}
{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/health",
      "rewrite": "/api/health"
    },
    {
      "route": "/api-docs/*",
      "rewrite": "/api/api-docs"
    },
    {
      "route": "/",
      "rewrite": "/api/"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/api/404"
    }
  },
  "platform": {
    "apiRuntime": "node:18"
  }
}
